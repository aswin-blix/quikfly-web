# Leave empty to run on the built-in mock API (demo mode).
# Set to your backend base URL to switch the whole site to the real API,
# e.g. http://localhost:8787/v1 for `npm run dev` at the repo root.
NEXT_PUBLIC_API_URL=

# Login code to show on screen while the API uses a fixed code instead of SMS
# (the API's DEMO_OTP). Leave empty to hide the hint. Ignored in demo mode.
NEXT_PUBLIC_DEMO_OTP=
