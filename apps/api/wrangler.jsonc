{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quikfly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Non-secret settings. Override per environment in the Cloudflare dashboard.
  "vars": {
    // Fixed login code while there is no SMS provider. Remove when real OTP is added.
    "DEMO_OTP": "1234",
    // Comma-separated website origins allowed to call the API, or "*" for any.
    "ALLOWED_ORIGINS": "*"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quikfly-db",
      // Replace with the id printed by `npx wrangler d1 create quikfly-db`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
