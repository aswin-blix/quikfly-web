{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quikfly-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Every minute: scheduled-ride reminders and push delivery (src/scheduled.ts). Free plan.
  "triggers": { "crons": ["* * * * *"] },
  // Non-secret settings. Override per environment in the Cloudflare dashboard.
  "vars": {
    // Fixed login code while there is no SMS provider. Remove when real OTP is added.
    "DEMO_OTP": "1234",
    // Comma-separated website origins allowed to call the API, or "*" for any.
    "ALLOWED_ORIGINS": "*"
  },
  // Partner document photos (private). Create once: npx wrangler r2 bucket create quikfly-docs
  "r2_buckets": [{ "binding": "DOCS", "bucket_name": "quikfly-docs" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "quikfly-db",
      "database_id": "99ec343a-609e-423f-8dbc-42019dc957b7",
      "migrations_dir": "migrations"
    }
  ]
}
