{
  "name": "@quikfly/api",
  "version": "0.1.0",
  "private": true,
  "author": "Aswin Blix (https://aswinblix.dev/)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply quikfly-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply quikfly-db --remote",
    "smoke": "node scripts/smoke.mjs",
    "smoke:admin": "node scripts/smoke-admin.mjs"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "@quikfly/shared": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.163.0"
  }
}
